# Sunucu
PORT=8080
PUBLIC_URL=https://api.slotsalonu.example
DATA_DIR=./data
APP_SECRET=uzun-rastgele-bir-deger
TRUST_PROXY=1
TZ_OFFSET_MIN=180

# Yönetici hesabı (ilk açılışta oluşturulur, sınırsız jeton yetkisi yalnızca bu hesapta)
ADMIN_EMAIL=yonetici@slotsalonu.example
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=GucluBirSifre123

# Google Play Billing (canlıda google; mock yalnızca test içindir)
BILLING_MODE=google
ANDROID_PACKAGE=com.slotsalonu.app
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/play-service-account.json
RTDN_SECRET=pubsub-push-url-sorgu-gizlisi

# E-posta (nodemailer kurulu olmalı: npm i nodemailer)
SMTP_URL=smtps://kullanici:sifre@smtp.ornek.com:465
MAIL_FROM=SLOT SALONU <no-reply@slotsalonu.example>
